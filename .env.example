# ===================================================
# ProfitPilot AI - Environment Configuration
# Problem Statement PS-02: Fly for profit. Land safe.
# ===================================================

# Application Environment
ENVIRONMENT=development
PORT_GATEWAY=5000
PORT_DATA=5001
PORT_AGENTS=5002
PORT_DECISION=5003
PORT_RISK=5004
PORT_EXCHANGE=5005
PORT_JOURNAL=5006
PORT_BACKTEST=5007
PORT_CHAOS=5008

# Databases (Docker / Local)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=profitpilot
MYSQL_DB=profitpilot
MONGO_URI=mongodb://localhost:27017/profitpilot

# Market Data & News
DATA_MODE=SIMULATED            # SIMULATED | REAL
DEFAULT_SYMBOL=RELIANCE.NS
PRICE_STALENESS_SECONDS=60
NEWS_STALENESS_SECONDS=300

# AI / LLM Configuration
LLM_PROVIDER=stub              # stub | openai | gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Security & Tokens
RISK_TOKEN_SECRET=profitpilot-risk-secret-key-32bytes-auth
JWT_SECRET=profitpilot-jwt-super-secret-key-2026

# Risk Controls (Defaults in % or Currency)
STARTING_CASH=100000.0
MAX_RISK_PER_TRADE_PCT=1.0      # 1% equity at risk per trade
DAILY_LOSS_LIMIT_PCT=2.0        # 2% start-of-day equity halt limit
DEFAULT_STOP_LOSS_PCT=1.5       # 1.5% distance
MAX_OPEN_POSITIONS=3
MAX_POSITION_VALUE_PCT=30.0     # Max 30% of portfolio in single symbol
MAKER_FEE_PCT=0.03              # 0.03% broker fee
SLIPPAGE_BPS=5                  # 5 bps slippage

